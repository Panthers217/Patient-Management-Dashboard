### Example environment variables for backend (DO NOT COMMIT secrets to repo)
# Copy to `.env` locally or set these values in Render's environment settings

DATABASE_URL=postgresql://pmddb:replace_with_password@db-host:5432/pmddb
JWT_SECRET=replace_with_a_strong_random_secret
PORT=4000
CORS_ORIGINS=https://your-site.netlify.app,http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
